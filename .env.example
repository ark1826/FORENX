# FOREnX - AI Digital Evidence Management
# Environment Variables Example Template

# Server Port (dynamic in cloud environments like Render, Railway, Cloud Run)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Gemini AI API Key (Get yours at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your-gemini-api-key-here"

# App Public URL
APP_URL="http://localhost:3000"

# JWT Secret Key for Session Authentication
JWT_SECRET="super-secret-jwt-key-change-in-production"

# Optional: MongoDB Connection String (Atlas or local)
# MONGO_URI="mongodb+srv://user:pass@cluster.mongodb.net/projects_db"
